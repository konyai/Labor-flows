df <- df %>% group_by(geo) %>% mutate(S=1-(lead(EMP)-lead(emps))/EMP) %>%
mutate(s=-log(S)/(365/4))
dfa <- dfa %>% group_by(geo) %>% mutate(S=1-(lead(EMP)-lead(emps))/EMP) %>%
mutate(s=-log(S)/365)
dfa <- df %>% mutate(year=year(time)) %>% group_by(geo,year) %>%
summarize(sq=mean(s,na.rm=TRUE)) %>% rename(time=year) %>% left_join(dfa)
View(dfa)
