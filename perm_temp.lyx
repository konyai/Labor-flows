\begin_layout Section*
Job tenure with temporary workers
\end_layout

\begin_layout Itemize
Assume that there are heterogenous workers according to employment contract length 
\begin_inset Formula $\tau$
\end_inset

.
\end_layout

\begin_layout Itemize
Temporary contracts dissolve after they run out,
 while permanent contracts separate with a probability 
\begin_inset Formula $\rho$
\end_inset

.
\end_layout

\begin_layout Itemize
All workers with contracts less than one period (quarter) will be separated
\end_layout

\begin_layout Itemize
Workers with contract length are distributed uniformly across the remaining time
\end_layout

\begin_layout Itemize
Separations within a period
\begin_inset Formula 
\[
n_{t}-\left(n_{t+1}-n^{s}_{t+1}\right)=n^{1}_{t}+\sum^{T}_{\tau=2}\frac{1}{T}n^{\tau}_{t}+\rho_{t}n^{\infty}_{t}
\]

\end_inset


\end_layout

